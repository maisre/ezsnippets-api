# compiled output
/dist
/node_modules
/build


# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output
/.devspace

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
# Catches .env.bak and friends — a stray backup of a secrets file is exactly
# the kind of thing that gets committed by accident.
.env.*
!.env.example

# Local one-off maintenance scripts (DB seeding, bulk content generation).
# Deliberately untracked — they run against a developer's own database.
/scripts/*

# ...except the snippet preview pipeline. These two are not one-off: they are
# re-run after every bulk snippet edit, they publish to a shared production
# bucket, and ez-infra's go-live checklist documents them by path.
!/scripts/capture-snippets.js
!/scripts/upload-snippet-shots.js

# Working notes for the snippet-library review. Untracked for now: this work
# is likely to move to its own repo, since authoring and repairing snippets
# isn't the api's job.
/docs/snippet-review-guide.md
# Audit output for the snippet review: a full-library browser audit plus the
# clustered offender list. Regenerable with scripts/audit-page.js, machine-
# specific, and large — kept next to the guide it belongs to rather than in
# /private/tmp, which gets cleared between sessions.
/docs/review-state/

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Snippet preview captures (scripts/capture-snippets.js). Published to the
# assets bucket by scripts/upload-snippet-shots.js; S3 is the source of truth,
# not git.
/snippet-shots/
